experiments/
results/
main_arcface/
checkpoints/

# Plots (generated by scripts)
*.png
*.pdf
*.svg

# ===== PYTHON =====
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/

# Virtual environments
.venv*/
venv*/
env/

