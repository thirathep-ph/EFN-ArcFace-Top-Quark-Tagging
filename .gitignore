# ===== LARGE DATA FILES (never commit) =====
# H5 datasets (train/val/test) - download separately
data/top_tagging/*.h5
data/top_tagging/*.hdf5

# Binary arrays (large, generated from H5)
*.npz
*.npy
!arcjet/config.json

# Model checkpoints (large, trained)
*.pt
*.pth
*.ckpt

# ===== GENERATED OUTPUTS (can be regenerated) =====
