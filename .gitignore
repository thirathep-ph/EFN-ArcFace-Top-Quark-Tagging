# ============================================================
# .gitignore — Jet Tagging Project
# Philosophy: Track CODE, ignore DATA, RESULTS & BUILD ARTIFACTS
# ============================================================

# ===== OPENCODE (personal assistant config) =====
.opencode/

# ===== DATA (never commit — download separately) =====
data/top_tagging/*.h5
data/top_tagging/*.hdf5
data/jetnet/*.hdf5

# ===== RESULTS (regenerable from code + data) =====
experiments/
results/
main_arcface/
checkpoints/

# ===== MODEL ARTIFACTS (large, trained) =====
*.pt
*.pth
*.ckpt
*.npz
*.npy

# ===== GENERATED PLOTS (regenerable from scripts) =====
*.png
*.pdf
*.svg

# ===== PYTHON =====
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/

# ===== VIRTUAL ENVIRONMENTS =====
.venv*/
venv*/
env/

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== OS =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== JUPYTER =====
.ipynb_checkpoints/

# ===== MISC =====
*.log
*_output.txt
*_out.txt
$null

# ===== PLANNING DOCS (paper prep, AI conversation, not for reproduction) =====
plans/

# ===== PAPER (separate repo / not tracked here) =====
paper/
submission.zip

# ===== LATEX BUILD ARTIFACTS =====
*.aux
*.bbl
*.blg
*.out
*.nav
*.snm
*.toc
*.vrb
*.synctex.gz

# ===== SCRATCH ARCHIVE (one-time exploration) =====
scratch/archive/
archive/
